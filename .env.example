# Copy this file to .env and supply credentials for your chosen provider.
# Existing environment variables override values in this file.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Use a model your endpoint supports. Both bargaining roles use this model.
# A nonempty model_id in the experiment JSON takes precedence.
MODEL_ID=replace-with-your-chat-model-id

# Absolute path, or relative to the directory containing the loaded .env.
# If no .env exists, relative paths use the current working directory.
BARGAINING_RESULTS_DIR=results
